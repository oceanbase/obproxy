  obproxy_obproxy_LDADD_MINIDUMP := ${DEP_DIR}/lib/libbreakpad_client.a
endif

if HAVE_BEYONDTRUST
  obproxy_obproxy_LDADD_BEYONDTRUST := ${DEP_DIR}/lib/libmist.a
endif

obproxy_obproxy_LDADD := ${obproxy_obproxy_LDADD_BASE} ${obproxy_obproxy_LDADD_MINIDUMP} ${obproxy_obproxy_LDADD_BEYONDTRUST}

if HAVE_SO
  obproxy_libobproxy_so_la_SOURCES :=
  obproxy_libobproxy_so_la_LIBADD := ${obproxy_obproxy_LDADD_BASE}
  obproxy_libobproxy_so_la_LDFLAGS :=${obproxy_obproxy_LDFLAGS} -shared -fPIC
endif

